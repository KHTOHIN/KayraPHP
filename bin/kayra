#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
|--------------------------------------------------------------------------
| KayraPHP — CLI entry point
|--------------------------------------------------------------------------
|
| The project root also has a `kayra` file that simply includes this one, so
| the documented command is `php kayra ...` from the project directory.
|
*/

use Kayra\Console\Kernel;

if (PHP_SAPI !== 'cli' && PHP_SAPI !== 'phpdbg') {
    fwrite(STDERR, "The kayra console must be run from the command line.\n");
    exit(1);
}

$root = dirname(__DIR__);

if (!is_file($root . '/vendor/autoload.php')) {
    fwrite(STDERR, "Dependencies are not installed. Run: composer install\n");
    exit(1);
}

require $root . '/vendor/autoload.php';

/** @var Kayra\Foundation\Application $app */
$app = require $root . '/bootstrap/app.php';

exit((new Kernel($app))->handle($argv));
