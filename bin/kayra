#!/usr/bin/env php
<?php

/*
|--------------------------------------------------------------------------
| KayraPHP — CLI entry point
|--------------------------------------------------------------------------
|
| The project root also has a `kayra` file that simply includes this one, so
| the documented command is `php kayra ...` from the project directory.
|
| declare(strict_types=1) is deliberately absent from this file: it must parse
| on whatever PHP the user happens to have on their PATH so that preflight.php
| can explain the problem, rather than failing before it gets the chance.
|
*/

if (PHP_SAPI !== 'cli' && PHP_SAPI !== 'phpdbg') {
    fwrite(STDERR, "The kayra console must be run from the command line.\n");
    exit(1);
}

$root = dirname(__DIR__);

// Checks the PHP version, extensions and vendor/ before anything else loads.
require $root . '/bootstrap/preflight.php';

require $root . '/vendor/autoload.php';

/** @var Kayra\Foundation\Application $app */
$app = require $root . '/bootstrap/app.php';

exit((new Kayra\Console\Kernel($app))->handle($argv));
