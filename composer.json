{
    "name": "kayraphp/framework",
    "description": "KayraPHP - a compile-first, runtime-agnostic PHP framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-uri": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "nikic/fast-route": "^1.3",
        "symfony/console": "^7.2",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "infection/infection": "^0.35.3",
        "php-http/psr7-integration-tests": "^1.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-opcache": "Required for production performance",
        "ext-pdo": "Database layer",
        "ext-redis": "Redis cache and session drivers",
        "ext-swoole": "Swoole runtime for long-running workers",
        "ext-sockets": "Required by some long-running runtimes"
    },
    "autoload": {
        "psr-4": {
            "Kayra\\": "core/",
            "App\\": "app/"
        },
        "files": [
            "core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kayra\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kayra"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "@php kayra optimize"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
