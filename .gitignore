/vendor/
/node_modules/

.env
.env.*
!.env.example

/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/logs/*
/storage/framework/views/*
/storage/framework/phpunit/*

# Live session payloads and rate-limiter counters. Sessions carry the signed-in
# user's identity, so committing one would publish a usable credential.
/storage/framework/sessions/*
/storage/framework/limiter/*

!/storage/**/.gitignore
.phpunit.result.cache
/.idea/
/.vscode/
.DS_Store
Thumbs.db
