APP_NAME=KayraPHP
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

APP_RUNTIME=auto
APP_HOST=127.0.0.1
APP_PORT=8000

LOG_CHANNEL=daily
LOG_LEVEL=debug

# Comma-separated. Leave empty unless a proxy really sits in front of the app.
TRUSTED_PROXIES=
HSTS_HEADER=

# Comma-separated exact origins, e.g. https://app.example.com
CORS_ORIGINS=
CORS_CREDENTIALS=false

# Comma-separated. Empty disables the check (development only).
TRUSTED_HOSTS=
