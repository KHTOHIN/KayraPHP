{
    "$schema": "vendor/infection/infection/resources/schema.json",

    // Mutation testing: change the code in small ways and check the suite
    // notices. A test that passes against a mutated framework was not testing
    // anything. Requires a coverage driver (pcov or xdebug) — see the CI
    // workflow, which installs pcov for this job.

    "source": {
        "directories": ["core"],
        "excludes": ["Console/Stubs"]
    },
    "logs": {
        "text": "storage/framework/infection.log",
        "summary": "storage/framework/infection-summary.log"
    },
    "mutators": {
        "@default": true
    },
    // Ratchets, not aspirations: raise these as coverage improves.
    "minMsi": 70,
    "minCoveredMsi": 80,
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit,Feature"
}
